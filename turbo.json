{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "API_URL",
    "PORT",
    "POKEAPI_TIMEOUT_MS",
    "POKEAPI_CACHE_TTL_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
