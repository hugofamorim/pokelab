{
  "name": "@pokelab/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint src test prisma.config.ts",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@pokelab/contracts": "workspace:*",
    "@pokelab/pokemon-domain": "workspace:*",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "dotenv": "18.0.8"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "@types/jest": "30.0.0",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "@types/pg": "8.23.1",
    "@nestjs/testing": "12.2.0",
    "@jest/globals": "30.5.2",
    "tsx": "4.23.15"
  },
  "type": "module"
}
