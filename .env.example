# Copy to apps/api/.env; development-only credentials, never use in production.
DATABASE_URL=postgresql://pokelab:pokelab_local@localhost:5432/pokelab?schema=public
PORT=3001
POKEAPI_TIMEOUT_MS=5000
POKEAPI_CACHE_TTL_SECONDS=86400
# Copy this setting to apps/web/.env.local (server-only, never NEXT_PUBLIC).
API_URL=http://127.0.0.1:3001
